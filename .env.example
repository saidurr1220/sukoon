# =============================================================================
# SUKOON ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# See ENVIRONMENT_VARIABLES.md for detailed documentation
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get these from Neon Console → Connection Details
# Use POOLED connection for DATABASE_URL (includes -pooler in hostname)
# Use DIRECT connection for DIRECT_URL (no -pooler in hostname)

DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/sukoon?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/sukoon?sslmode=require"

# -----------------------------------------------------------------------------
# EMAIL SERVICE CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Get this from Resend Dashboard → API Keys
# Format: re_[alphanumeric_string]

RESEND_API_KEY="re_your_resend_api_key_here"

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (Required)
# -----------------------------------------------------------------------------
# Application name displayed in UI and emails
NEXT_PUBLIC_APP_NAME="Sukoon"

# Full URL of your application
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app or https://your-custom-domain.com
NEXT_PUBLIC_APP_URL="https://sukoon-flax.vercel.app/"

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION (Highly Recommended for Production)
# -----------------------------------------------------------------------------
# Generate secure random strings using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Secret for authenticating cron job requests
CRON_SECRET="your_secure_random_string_here"

# Secret for signing unsubscribe tokens
UNSUBSCRIBE_SECRET="your_secure_random_string_for_unsubscribe_tokens"

# -----------------------------------------------------------------------------
# LLM CONFIGURATION (Optional - Choose one provider)
# -----------------------------------------------------------------------------
# Gemini API Key (Recommended - Free tier available)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-your_openai_api_key_here"

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/
# ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_here"

# -----------------------------------------------------------------------------
# DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Uncomment for local development debugging
# NODE_ENV="development"
